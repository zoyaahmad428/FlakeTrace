@startuml diagnose_sequence
skinparam dpi 200
skinparam defaultFontName Helvetica
skinparam defaultFontSize 11
skinparam shadowing false
skinparam sequenceMessageAlign left
skinparam ParticipantPadding 2
skinparam BoxPadding 2
hide footbox
autonumber

participant "cli.py" as cli
participant "eval.report" as rep
participant "evidence" as ext
participant "diagnose.py" as diag
participant "Recording\nRunner" as rec
participant "Order\nRunner" as orun
participant "JVM" as jvm

[-> cli : diagnose
cli -> diag : diagnose()\nbad input: exit 2
diag -> diag : integrity snapshot
diag -> orun ** : new:\nmvn, javac
diag -> orun : list_methods
orun -> jvm : ~--list
jvm --> orun : IDs
orun --> diag : order
diag -> rec ** : new: header

loop run_steps, each run (activity diagram)
  diag -> rec : run_ordered
  rec -> orun : run_ordered
  orun -> jvm : fresh JVM
  jvm --> orun : results
  orun --> rec : outcomes
  rec -> rec : log run
  rec --> diag : outcomes
end

diag -> diag : integrity compare
diag --> cli : DiagnosisRuns\nMaven/Java failed: exit 1

alt POLLUTER_FOUND
  loop each polluter
    cli -> ext : analyse_pair\ndepth 2 (deeper\nonly if none)
    ext --> cli : pair
  end
  cli -> ext : report_fields\nper pair
  ext --> cli : fields\nerror: exit 1
end

cli -> rep : assemble_report
alt NO_SINGLE_POLLUTER
  rep --> cli : UnhandledStatus
  [<-- cli : no report, exit 3
else other statuses
  rep -> rep : decide, validate
  rep --> cli : report
  cli -> cli : write .report.json
  [<-- cli : summary, exit 0
end

@enduml
