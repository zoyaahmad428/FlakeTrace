' run_steps in runner/diagnose.py, drawn as two halves joined side by side by
' scripts/join_activity.py (one figure, readable at text width).
@startuml search_activity_a
skinparam dpi 200
skinparam defaultFontName Helvetica
skinparam defaultFontSize 11
skinparam shadowing false
skinparam ActivityBackgroundColor #F7F7F7
skinparam ActivityBorderColor #333333
skinparam PartitionBorderColor #999999

title (a) Reproduce, shuffle, alone check
start
:order = tests up to the victim;
partition "Reproduce (search.py)" {
  :run order up to n times,
  stop at first real failure
  (not a crash, timeout, skip);
}
if (failed?) then (no)
  if (shuffles > 0?) then (yes)
    partition "Shuffle (orders.py)" {
      :up to ~--shuffles (31)
      class-first shuffled
      orders, each once;
      if (real failure?) then (yes)
        :order = that order;
      else (no)
      endif
    }
  else (no)
  endif
else (yes)
endif
partition "Alone check (verify.py)" {
  if (reference failure?) then (no)
    :victim alone n times;
    if (real failure?) then (yes)
      #DDDDDD:VICTIM_FAILS_ALONE;
      stop
    else (no)
      #DDDDDD:NOT_REPRODUCED;
      stop
    endif
  else (yes)
    :victim alone n times;
    if (>= 1 match?) then (yes)
      #DDDDDD:VICTIM_FAILS_ALONE;
      stop
    else (no)
    endif
  endif
}
(B)
detach
@enduml

@startuml search_activity_b
skinparam dpi 200
skinparam defaultFontName Helvetica
skinparam defaultFontSize 11
skinparam shadowing false
skinparam ActivityBackgroundColor #F7F7F7
skinparam ActivityBorderColor #333333
skinparam PartitionBorderColor #999999

title (b) Search, minimise, verify
(B)
partition "Search (search.py)" {
  :run [test, victim] once
  per earlier test (priority
  hook first; CLI passes none);
  if (fails with reference?) then (yes)
    :polluters = [test];
  else (none)
    :polluters = [];
  endif
}
if (none and > 2 tests?) then (yes)
  partition "Minimise (minimise.py)" {
    :run full order once more;
    if (fails with reference?) then (yes)
      :ddmin over earlier tests
      (1-minimal, not minimum);
      :polluters = result;
    else (no)
    endif
  }
else (no)
endif
partition "Verify (verify.py)" {
  :sequence = polluters + victim,
  else the failing order;
  :run it n times, count
  matching failures;
}
if (polluters?) then (yes)
  #DDDDDD:POLLUTER_FOUND;
else (no)
  #DDDDDD:NO_SINGLE_POLLUTER;
endif
stop
@enduml
